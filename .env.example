# ===================================================================
# SkillBridge — Frontend Environment Configuration (.env.example)
# ===================================================================

# Base REST API endpoint for the Express backend
VITE_API_BASE_URL=http://localhost:5000/api
# Fallback alias supported by client
VITE_API_URL=http://localhost:5000/api

# WebSocket / Socket.IO server URL for real-time messaging & alerts
VITE_SOCKET_URL=http://localhost:5000
