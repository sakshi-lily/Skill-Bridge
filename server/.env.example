# SkillBridge Environment Configuration Template

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=skillbridge_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRE=30d

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
